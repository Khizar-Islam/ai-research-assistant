# URL of the Express API (backend/). Read at build time, so restart `next dev` after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────────────
# Encrypts NextAuth's session cookie. Only this app uses it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="generate-a-random-secret"

# Signs the short-lived API tokens the browser sends to Express. Must be the SAME value as
# API_JWT_SECRET in backend/.env.
API_JWT_SECRET="same-value-as-backend"

# Google OAuth client: Google Cloud Console → APIs & Services → Credentials → OAuth client
# ID (Web application). Redirect URI: http://localhost:3000/api/auth/callback/google
# Leave empty to run without Google sign-in (the sign-in page says it isn't configured).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Development only: a "Continue as Dev Tester" button that signs in as the fixed test user
# dev-tester@footnote.test without Google. Put it in .env.development.local (read by
# `next dev` only), NOT in .env.local: a production build that sees it refuses to start.
# AUTH_DEV_LOGIN=true
