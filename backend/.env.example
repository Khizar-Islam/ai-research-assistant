# Supabase → Connect → Transaction pooler (port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres"
# Supabase → Connect → Session pooler (port 5432). Used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"

# Google AI Studio → https://aistudio.google.com/apikey → Create API key
GEMINI_API_KEY="your-gemini-api-key"

# Shared secret for the API tokens the Next.js app signs and this API verifies. Must be
# the same value as API_JWT_SECRET in web/.env.local. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_JWT_SECRET="generate-a-random-secret"

# Optional locally — defaults shown
# Answer-writing model, and the model tried automatically when it stays unavailable
# (5xx, timeout) before any answer text is sent. Same id in both turns the fallback off.
# GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"
# GEMINI_CHAT_FALLBACK_MODEL="gemini-3.6-flash"
# NODE_ENV=development
# PORT=4000
# CORS_ORIGIN="http://localhost:3000"
# Number of proxies in front of the API, 0 to 5, default 0 (trust proxy off).
# TRUST_PROXY_HOPS=0

# ── Production (Render) ───────────────────────────────────────────────────────────────
# NODE_ENV=production   Required: on Render the API refuses to start without it, because
#                       development mode accepts the dev sign-in's identities.
# CORS_ORIGIN           Required in production: the web app's URL exactly as the browser
#                       sends it, https:// with no path or trailing slash, e.g.
#                       https://your-app.vercel.app (comma-separate several).
# PORT                  Don't set it: Render provides it.
# DIRECT_URL            Set it there too: the Prisma CLI reads it during the build.
# TRUST_PROXY_HOPS=3    On Render (measured: visitor, Cloudflare, Render's proxy). Too low
#                       and every visitor shares one rate-limit counter; too high and
#                       visitors can fake their IP with their own X-Forwarded-For header.
